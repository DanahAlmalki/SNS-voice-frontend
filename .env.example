# Copy to .env (gitignored) and fill in real values. See src/lib/env-config
# notes / README for details on each var.

# Required for campaign creation (POST /api/v1/campaigns) and for the real
# outbound-call bridge (POST /outbound-call) — both check this same key.
CAMPAIGN_API_KEY=

# Server-only (dev-proxy target), optional — defaults to the deployed backend.
# CAMPAIGN_API_TARGET=https://voice-containerapp.jollygrass-66012e86.westus3.azurecontainerapps.io

# Server-only (dev-proxy target for real calls), optional — defaults to
# twilio_bridge.py's own local default port.
# TWILIO_BRIDGE_TARGET=http://localhost:8080

# Client-exposed, optional — leave unset in local dev so requests go through
# the proxy above instead of straight to a backend (which would require
# bundling CAMPAIGN_API_KEY into the browser).
# VITE_CAMPAIGN_API_BASE=
# VITE_OUTBOUND_CALL_API_BASE=

# Client-exposed, optional — WebSocket URL for the in-browser trial call.
# VITE_VOICE_WS_URL=wss://voice-containerapp.jollygrass-66012e86.westus3.azurecontainerapps.io/ws
